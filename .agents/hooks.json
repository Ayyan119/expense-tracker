{
  "protect-sensitive-files": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/hooks/protect-sensitive-files.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

